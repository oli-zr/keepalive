    "Add your Apple Account in Xcode’s settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deinen Apple Account in den Einstellungen von Xcode hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu cuenta de Apple en los ajustes de Xcode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre compte Apple dans les réglages de Xcode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcodeの設定でApple Accountを追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Xcode 设置中添加你的 Apple 账户。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione sua Conta Apple nos ajustes do Xcode."
          }
        }
      }
    },

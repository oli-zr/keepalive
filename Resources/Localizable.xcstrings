    "The update was not downloaded from GitHub and was discarded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update stammt nicht von GitHub und wurde verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización no se ha descargado de GitHub y se ha descartado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour ne provient pas de GitHub et a été supprimée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートがGitHubからダウンロードされたものではないため破棄しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该更新并非从 GitHub 下载，已被丢弃。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização não foi baixada do GitHub e foi descartada."
          }
        }
      }
    },
    "The “Before Build” command failed: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl unter „Vor dem Build“ ist fehlgeschlagen: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error en el comando de “Antes de compilar”: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la commande « Avant la compilation » : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ビルド前」のコマンドに失敗しました：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“构建前”命令失败：%@"
          }
        },
        "pt-BR": {
          "stringUnit": {

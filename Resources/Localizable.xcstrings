    "No provisioning profile could be created. Open the project in Xcode once and select your Personal Team under Signing & Capabilities.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte kein Provisioning-Profil erstellt werden. Öffne das Projekt einmal in Xcode und wähle unter „Signing & Capabilities“ dein Personal Team."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido crear un perfil de aprovisionamiento. Abre el proyecto una vez en Xcode y selecciona tu Personal Team en “Signing & Capabilities”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer un profil de provisionnement. Ouvrez le projet une fois dans Xcode et sélectionnez votre Personal Team dans « Signing & Capabilities »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロビジョニングプロファイルを作成できませんでした。Xcodeでプロジェクトを一度開き、「Signing & Capabilities」でPersonal Teamを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建描述文件。请在 Xcode 中打开一次项目，并在“Signing & Capabilities”中选择你的 Personal Team。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar um perfil de provisionamento. Abra o projeto uma vez no Xcode e selecione seu Personal Team em “Signing & Capabilities”."
          }
        }
      }

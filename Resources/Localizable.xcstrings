    "Stop Renewing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneuern stoppen"
          }
        }
      }
    },
    "The app stays on your devices, but KeepAlive will stop renewing it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App bleibt auf deinen Geräten, wird aber nicht mehr von KeepAlive erneuert."
          }
        }
      }
    },
    "The build finished, but %@ was not found.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Build ist fertig, aber %@ wurde nicht gefunden."
          }
        }
      }
    },
    "The device could not be reached. Make sure it is on the same Wi‑Fi as this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät ist nicht erreichbar. Stelle sicher, dass es im selben WLAN wie dieser Mac ist."
          }
        }
      }
    },
    "The downloaded update is damaged and was discarded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geladene Update ist beschädigt und wurde verworfen."
          }
        }
      }
    },
    "The downloaded update is not a valid version of KeepAlive and was discarded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geladene Update ist keine gültige Version von KeepAlive und wurde verworfen."
          }
        }
      }
    },
    "The project could not be read: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Projekt konnte nicht gelesen werden: %@"
          }
        }
      }
    },
    "The release does not contain KeepAlive.zip.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Release enthält keine KeepAlive.zip."
          }
        }
      }
    },
    "The selected folder does not contain an .xcodeproj or .xcworkspace.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ausgewählte Ordner enthält kein .xcodeproj oder .xcworkspace."
          }
        }
      }
    },
    "The update was not downloaded from GitHub and was discarded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update stammt nicht von GitHub und wurde verworfen."
          }
        }
      }
    },
    "The “Before Build” command failed: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl unter „Vor dem Build“ ist fehlgeschlagen: %@"
          }
        }
      }
    },
    "This app is turned off on every device. Turn on a device in its details under Apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App ist auf allen Geräten ausgeschaltet. Schalte in ihren Details unter Apps ein Gerät ein."
          }
        }
      }
    },
    "This device is not in the app’s provisioning profile. Open the project in Xcode and run it on this device once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist nicht im Provisioning-Profil der App. Öffne das Projekt in Xcode und führe es einmal auf diesem Gerät aus."
          }
        }
      }
    },
    "This scheme does not build an iOS app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Schema erstellt keine iOS-App."
          }
        }
      }
    },
    "To renew over Wi‑Fi, connect your iPhone or iPad to this Mac with a cable once and tap Trust on the device. With Xcode 26 or earlier, also turn on “Connect via network” under Window → Devices and Simulators.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit über WLAN erneuert werden kann, verbinde dein iPhone oder iPad einmal per Kabel mit diesem Mac und tippe auf dem Gerät auf „Vertrauen“. Mit Xcode 26 oder älter aktiviere außerdem „Connect via network“ unter Window → Devices and Simulators."
          }
        }
      }
    },
    "Turn on Developer Mode on the device in Settings → Privacy & Security.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere auf dem Gerät den Entwicklermodus unter Einstellungen → Datenschutz & Sicherheit."
          }
        }
      }
    },
    "Unlock %@ once so KeepAlive can install apps. It will try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre %@ einmal, damit KeepAlive Apps installieren kann. KeepAlive versucht es später erneut."
          }
        }
      }
    },
    "Unlock the device and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre das Gerät und versuche es erneut."
          }
        }
      }
    },
    "Updated from %@ to %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von %1$@ auf %2$@ aktualisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated from %1$@ to %2$@."
          }
        }
      }
    },

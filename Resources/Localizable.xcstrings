    "A free Apple Account can create ten new app IDs per week. Try again in a few days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem kostenlosen Apple Account lassen sich zehn neue App-IDs pro Woche erstellen. Versuche es in ein paar Tagen erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una cuenta de Apple gratuita se pueden crear diez nuevos ID de app por semana. Vuelve a intentarlo dentro de unos días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte Apple gratuit peut créer dix nouveaux identifiants d’app par semaine. Réessayez dans quelques jours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料のApple Accountで作成できる新しいApp IDは週に10個までです。数日後にもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费 Apple 账户每周最多可创建 10 个新的 App ID。请过几天再试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma Conta Apple gratuita pode criar dez novos IDs de app por semana. Tente novamente em alguns dias."
          }
        }
      }
    },
    "A free Apple Account can have three of your own apps on a device at the same time. Remove one of them from the device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem kostenlosen Apple Account können drei eigene Apps gleichzeitig auf einem Gerät sein. Entferne eine davon vom Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una cuenta de Apple gratuita puedes tener tres apps propias a la vez en un dispositivo. Elimina una de ellas del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte Apple gratuit permet d’avoir trois de vos propres apps à la fois sur un appareil. Supprimez-en une de l’appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料のApple Accountでは、1台のデバイスに同時にインストールできる自作のAppは3つまでです。いずれかをデバイスから削除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用免费 Apple 账户时，一台设备上最多可同时安装 3 个你自己的 App。请从设备上移除其中一个。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma Conta Apple gratuita, você pode ter três apps próprios ao mesmo tempo em um dispositivo. Remova um deles do dispositivo."
          }
        }
      }
    },
    "A free Apple Account can have up to three of your own apps installed on a device at the same time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem kostenlosen Apple Account können bis zu drei eigene Apps gleichzeitig auf einem Gerät installiert sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una cuenta de Apple gratuita puedes tener hasta tres apps propias instaladas a la vez en un dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte Apple gratuit permet d’installer jusqu’à trois de vos propres apps à la fois sur un appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料のApple Accountでは、1台のデバイスに同時にインストールできる自作のAppは3つまでです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用免费 Apple 账户时，一台设备上最多可同时安装 3 个你自己的 App。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma Conta Apple gratuita, você pode ter até três apps próprios instalados ao mesmo tempo em um dispositivo."
          }
        }
      }
    },

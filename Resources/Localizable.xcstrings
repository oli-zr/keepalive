        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguration"
          }
        }
      }
    },
    "Connect %@ to the same Wi‑Fi as this Mac so KeepAlive can renew it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde %@ mit dem WLAN dieses Macs, damit KeepAlive die App erneuern kann."
          }
        }
      }
    },

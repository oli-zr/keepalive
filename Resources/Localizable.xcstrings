            "value": "O comando de “Antes da compilação” falhou: %@"
          }
        }
      }
    },
    "This app is turned off on every device. Turn on a device in its details under Apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App ist auf allen Geräten ausgeschaltet. Schalte in ihren Details unter Apps ein Gerät ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app está desactivada en todos los dispositivos. Activa un dispositivo en sus detalles, en Apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app est désactivée sur tous les appareils. Activez un appareil dans ses détails, dans Apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このAppはすべてのデバイスでオフになっています。「App」でこのAppの詳細を開き、デバイスをオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 在所有设备上均已关闭。请在“App”中打开它的详细信息并打开一台设备。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app está desativado em todos os dispositivos. Ative um dispositivo nos detalhes dele, em Apps."
          }
        }
      }
    },
    "This device is not in the app’s provisioning profile. Open the project in Xcode and run it on this device once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist nicht im Provisioning-Profil der App. Öffne das Projekt in Xcode und führe es einmal auf diesem Gerät aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no está en el perfil de aprovisionamiento de la app. Abre el proyecto en Xcode y ejecútalo una vez en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne figure pas dans le profil de provisionnement de l’app. Ouvrez le projet dans Xcode et exécutez-le une fois sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはAppのプロビジョニングプロファイルに含まれていません。Xcodeでプロジェクトを開き、このデバイスで一度実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不在该 App 的描述文件中。请在 Xcode 中打开项目，并在此设备上运行一次。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não está no perfil de provisionamento do app. Abra o projeto no Xcode e execute-o uma vez neste dispositivo."
          }
        }
      }
    },
    "This scheme does not build an iOS app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Schema erstellt keine iOS-App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este esquema no compila una app de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce schéma ne compile pas d’app iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスキームはiOS Appをビルドしません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此方案不会构建 iOS App。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este esquema não compila um app para iOS."
          }
        }
      }
    },
    "To renew over Wi‑Fi, connect your iPhone or iPad to this Mac with a cable once and tap Trust on the device. With Xcode 26 or earlier, also turn on “Connect via network” under Window → Devices and Simulators.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit über WLAN erneuert werden kann, verbinde dein iPhone oder iPad einmal per Kabel mit diesem Mac und tippe auf dem Gerät auf „Vertrauen“. Mit Xcode 26 oder älter aktiviere außerdem „Connect via network“ unter Window → Devices and Simulators."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para renovar por Wi‑Fi, conecta tu iPhone o iPad a este Mac con un cable una vez y toca “Confiar” en el dispositivo. Con Xcode 26 o anterior, activa también “Connect via network” en Window → Devices and Simulators."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour renouveler par Wi‑Fi, connectez une fois votre iPhone ou iPad à ce Mac avec un câble, puis touchez « Se fier » sur l’appareil. Avec Xcode 26 ou une version antérieure, activez aussi « Connect via network » dans Window → Devices and Simulators."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fi経由で更新するには、iPhoneまたはiPadをケーブルでこのMacに一度接続し、デバイスで「信頼」をタップしてください。Xcode 26以前では、Window → Devices and Simulatorsで「Connect via network」もオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若要通过无线局域网续期，请用线缆将 iPhone 或 iPad 连接到这台 Mac 一次，并在设备上轻点“信任”。使用 Xcode 26 或更早版本时，还需在 Window → Devices and Simulators 中打开“Connect via network”。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para renovar por Wi‑Fi, conecte seu iPhone ou iPad a este Mac com um cabo uma vez e toque em “Confiar” no dispositivo. Com o Xcode 26 ou anterior, ative também “Connect via network” em Window → Devices and Simulators."
          }
        }
      }
    },
    "Turn on Developer Mode on the device in Settings → Privacy & Security.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere auf dem Gerät den Entwicklermodus unter Einstellungen → Datenschutz & Sicherheit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el modo de desarrollador en el dispositivo en Ajustes → Privacidad y seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le mode développeur sur l’appareil dans Réglages → Confidentialité et sécurité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの「設定」→「プライバシーとセキュリティ」でデベロッパモードをオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设备的“设置”→“隐私与安全性”中打开开发者模式。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Modo de Desenvolvedor no dispositivo em Ajustes → Privacidade e Segurança."
          }
        }
      }
    },
    "Unlock %@ once so KeepAlive can install apps. It will try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre %@ einmal, damit KeepAlive Apps installieren kann. KeepAlive versucht es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea %@ una vez para que KeepAlive pueda instalar apps. Lo volverá a intentar más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez %@ une fois pour que KeepAlive puisse installer des apps. Il réessaiera plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KeepAliveがAppをインストールできるように、%@のロックを一度解除してください。あとでもう一度試します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请解锁“%@”一次，以便 KeepAlive 安装 App。稍后会再试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie %@ uma vez para que o KeepAlive possa instalar apps. Ele tentará novamente mais tarde."
          }
        }
      }
    },
    "Unlock the device and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre das Gerät und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea el dispositivo y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez l’appareil et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのロックを解除して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请解锁设备后重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o dispositivo e tente novamente."
          }
        }
      }
    },
    "Updated from %@ to %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von %1$@ auf %2$@ aktualisiert."

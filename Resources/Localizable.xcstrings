    },
    "KeepAlive installs your apps on every device that is turned on. On a device that is turned off, they stay installed but are no longer renewed. To choose devices for a single app, open its details under Apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KeepAlive installiert deine Apps auf jedem eingeschalteten Gerät. Auf ausgeschalteten Geräten bleiben sie installiert, werden aber nicht mehr erneuert. Um Geräte für eine einzelne App auszuwählen, öffne ihre Details unter Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "KeepAlive instala tus apps en todos los dispositivos activados. En un dispositivo desactivado, las apps siguen instaladas pero ya no se renuevan. Para elegir los dispositivos de una sola app, abre sus detalles en Apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "KeepAlive installe vos apps sur chaque appareil activé. Sur un appareil désactivé, elles restent installées mais ne sont plus renouvelées. Pour choisir les appareils d’une seule app, ouvrez ses détails dans Apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KeepAliveは、オンになっているすべてのデバイスにAppをインストールします。オフにしたデバイスではAppはインストールされたままですが、更新されなくなります。App個別にデバイスを選ぶには、「App」でそのAppの詳細を開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "KeepAlive 会将你的 App 安装到所有已打开的设备上。在已关闭的设备上，App 仍会保留，但不再续期。若要为单个 App 选择设备，请在“App”中打开它的详细信息。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O KeepAlive instala seus apps em todos os dispositivos ativados. Em um dispositivo desativado, eles continuam instalados, mas não são mais renovados. Para escolher os dispositivos de um app específico, abra os detalhes dele em Apps."
          }
        }
      }
    },
    "KeepAlive is up to date.": {
      "localizations": {

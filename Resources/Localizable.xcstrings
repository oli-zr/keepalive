    "Cancelled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgebrochen."
          }
        }
      }
    },
    "Check for Updates Automatically": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch nach Updates suchen"
          }
        }

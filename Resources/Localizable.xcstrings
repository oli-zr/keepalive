    "The app stays on your devices, but KeepAlive will stop renewing it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App bleibt auf deinen Geräten, wird aber nicht mehr von KeepAlive erneuert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app seguirá en tus dispositivos, pero KeepAlive dejará de renovarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app reste sur vos appareils, mais KeepAlive ne la renouvellera plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appはデバイスに残りますが、KeepAliveによる更新は行われなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该 App 会保留在你的设备上，但 KeepAlive 将不再为其续期。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app continuará nos seus dispositivos, mas o KeepAlive deixará de renová-lo."
          }
        }
      }
    },
    "The build finished, but %@ was not found.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Build ist fertig, aber %@ wurde nicht gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compilación ha terminado, pero no se ha encontrado %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La compilation est terminée, mais %@ est introuvable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルドは完了しましたが、%@が見つかりませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建已完成，但未找到 %@。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compilação terminou, mas %@ não foi encontrado."
          }
        }
      }
    },
    "The device could not be reached. Make sure it is on the same Wi‑Fi as this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät ist nicht erreichbar. Stelle sicher, dass es im selben WLAN wie dieser Mac ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con el dispositivo. Asegúrate de que esté en la misma red Wi‑Fi que este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil est injoignable. Assurez-vous qu’il est sur le même réseau Wi‑Fi que ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスに接続できません。このMacと同じWi‑Fiに接続されていることを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接设备。请确保它与这台 Mac 连接到同一无线局域网。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível conectar ao dispositivo. Verifique se ele está na mesma rede Wi‑Fi deste Mac."
          }
        }
      }
    },
    "The downloaded update is damaged and was discarded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geladene Update ist beschädigt und wurde verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización descargada está dañada y se ha descartado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour téléchargée est endommagée et a été supprimée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたアップデートは破損していたため破棄しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的更新已损坏，已被丢弃。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização baixada está danificada e foi descartada."
          }
        }
      }
    },
    "The downloaded update is not a valid version of KeepAlive and was discarded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geladene Update ist keine gültige Version von KeepAlive und wurde verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización descargada no es una versión válida de KeepAlive y se ha descartado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour téléchargée n’est pas une version valide de KeepAlive et a été supprimée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたアップデートは有効なKeepAliveではないため破棄しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的更新不是有效的 KeepAlive 版本，已被丢弃。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização baixada não é uma versão válida do KeepAlive e foi descartada."
          }
        }
      }
    },
    "The project could not be read: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",

          }
        }
      }
    },
    "%@: expires %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft auf %1$@ %2$@ ab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: caduca %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : expire %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：有効期限 %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@过期"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: expira %2$@"
          }
        }
      }
    },
    "%lld devices": {
      "localizations": {

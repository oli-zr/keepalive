# Versions used by the Build workflow. The Update tools workflow keeps them current and
# opens a pull request when a newer one is available, so there is no need to edit this by hand.
# Dependabot updates the actions themselves.

# GitHub-hosted runner image with the newest Xcode.
XCODE_RUNNER=xcode-27
# https://github.com/rhysd/actionlint
ACTIONLINT_VERSION=1.7.12
# https://github.com/koalaman/shellcheck
SHELLCHECK_VERSION=0.11.0

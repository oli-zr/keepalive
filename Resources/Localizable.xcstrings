      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswählen"
          }
        }
      }
    },
    "Choose an Xcode project, a workspace or the folder that contains it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Xcode-Projekt, einen Workspace oder den Ordner, der ihn enthält."

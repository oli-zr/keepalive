{
  "sourceLanguage": "en",
  "strings": {
    "%@ could not be added to the provisioning profile. Open the project in Xcode and run it on %@ once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ konnte nicht zum Provisioning-Profil hinzugefügt werden. Öffne das Projekt in Xcode und führe es einmal auf %2$@ aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido añadir %1$@ al perfil de aprovisionamiento. Abre el proyecto en Xcode y ejecútalo una vez en %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ajouter %1$@ au profil de provisionnement. Ouvrez le projet dans Xcode et exécutez-le une fois sur %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@をプロビジョニングプロファイルに追加できませんでした。Xcodeでプロジェクトを開き、%2$@で一度実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将“%1$@”添加到描述文件。请在 Xcode 中打开项目，并在“%2$@”上运行一次。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível adicionar %1$@ ao perfil de provisionamento. Abra o projeto no Xcode e execute-o uma vez em %2$@."
          }
        }
      }
    },
    "%@ could not be renewed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ konnte nicht erneuert werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido renovar “%@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de renouveler « %@ »"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を更新できませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法续期“%@”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível renovar “%@”"
          }
        }
      }
    },
    "%@ expires soon": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ läuft bald ab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” caducará pronto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » expire bientôt"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の有効期限がまもなく切れます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”即将过期"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” expira em breve"
          }
        }
      }
    },
    "%@ expires soon on %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ läuft auf %2$@ bald ab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” caducará pronto en %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » expire bientôt sur %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@の「%1$@」の有効期限がまもなく切れます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@”上的“%1$@”即将过期"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” expira em breve em %2$@"
          }
        }
      }
    },
    "%@ is not reachable. KeepAlive will try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht erreichbar. KeepAlive versucht es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con %@. KeepAlive lo volverá a intentar más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est injoignable. KeepAlive réessaiera plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に接続できません。KeepAliveはあとでもう一度試します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接“%@”。KeepAlive 稍后会再试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível conectar a %@. O KeepAlive tentará novamente mais tarde."
          }
        }
      }
    },
    "%@ took too long and was stopped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat zu lange gedauert und wurde abgebrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha tardado demasiado y se ha detenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a pris trop de temps et a été arrêté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に時間がかかりすぎたため停止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 耗时过长，已停止。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demorou demais e foi interrompido."
          }
        }
      }
    },
    "%@ · Not reachable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Nicht erreichbar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Sin conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Injoignable"
          }
        },
        "ja": {

    "Add an Xcode project, and KeepAlive keeps its app installed on your iPhone or iPad.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Xcode-Projekt hinzu, damit seine App auf deinem iPhone oder iPad installiert bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un proyecto de Xcode y KeepAlive mantendrá su app instalada en tu iPhone o iPad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un projet Xcode et KeepAlive gardera son app installée sur votre iPhone ou iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcodeプロジェクトを追加すると、KeepAliveがそのAppをiPhoneやiPadにインストールしたまま維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Xcode 项目后，KeepAlive 会让它的 App 一直安装在你的 iPhone 或 iPad 上。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um projeto do Xcode e o KeepAlive manterá o app dele instalado no seu iPhone ou iPad."
          }
        }
      }
    },
    "Add App…": {
      "localizations": {
        "de": {
          "stringUnit": {

            "value": "Der ausgewählte Ordner enthält kein .xcodeproj oder .xcworkspace."
          }
        }
      }
    },
    "The update was not downloaded from GitHub and was discarded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update stammt nicht von GitHub und wurde verworfen."
          }
        }
      }
    },
    "This scheme does not build an iOS app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Schema erstellt keine iOS-App."
          }
        }
      }
    },
    "To renew over Wi‑Fi, connect your iPhone to this Mac with a cable once. Then open Xcode, choose Window → Devices and Simulators, and select “Connect via network”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit über WLAN erneuert werden kann, verbinde dein iPhone einmal per Kabel mit diesem Mac. Öffne dann Xcode, wähle Window → Devices and Simulators und aktiviere „Connect via network“."
          }
        }
      }
    },
    "Turn on Developer Mode on your iPhone in Settings → Privacy & Security.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Entwicklermodus auf deinem iPhone unter Einstellungen → Datenschutz & Sicherheit."
          }
        }
      }
    },
    "Unlock your iPhone and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre dein iPhone und versuche es erneut."
          }
        }
      }
    },
    "Updated from %@ to %@.": {
      "localizations": {

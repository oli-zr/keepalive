{
  "sourceLanguage": "en",
  "strings": {
    "%@ could not be renewed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ konnte nicht erneuert werden"
          }
        }
      }
    },
    "%@ expires soon": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ läuft bald ab"
          }
        }
      }
    },
    "%@ is not reachable. KeepAlive will try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht erreichbar. KeepAlive versucht es später erneut."
          }
        }
      }
    },
    "%@ took too long and was stopped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat zu lange gedauert und wurde abgebrochen."
          }
        }
      }
    },
    "%@ · Not reachable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Nicht erreichbar"
          }
        }
      }
    },
    "A free Apple Account can have up to three of your own apps installed on a device at the same time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem kostenlosen Apple Account können bis zu drei eigene Apps gleichzeitig auf einem Gerät installiert sein."
          }
        }
      }
    },
    "Activity": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivität"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen"
          }
        }
      }
    },
    "Add an Xcode project to keep it installed on your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Xcode-Projekt hinzu, damit es auf deinem iPhone installiert bleibt."
          }
        }
      }
    },
    "Add App…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App hinzufügen …"
          }
        }
      }
    },
    "Added.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzugefügt."
          }
        }
      }
    },
    "Apple’s limit for free accounts was reached. Remove an app from your iPhone or wait a few days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit für kostenlose Accounts ist erreicht. Entferne eine App von deinem iPhone oder warte ein paar Tage."
          }
        }
      }
    },
    "Apps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps"
          }
        }
      }
    },
    "Apps signed with a free Apple Account stop opening after seven days. KeepAlive renews them early, whenever your iPhone is on the same network. Apps that expire within a day are renewed on battery power too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die mit einem kostenlosen Apple Account signiert sind, lassen sich nach sieben Tagen nicht mehr öffnen. KeepAlive erneuert sie frühzeitig, sobald dein iPhone im selben Netzwerk ist. Apps, die innerhalb eines Tages ablaufen, werden auch im Batteriebetrieb erneuert."
          }
        }
      }
    },
    "Before Build": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Build"
          }
        }
      }
    },

    "Updates are installed while no app is being built. Your apps and settings are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates werden installiert, während keine App gebaut wird. Deine Apps und Einstellungen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones se instalan mientras no se compila ninguna app. Tus apps y ajustes se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour sont installées quand aucune app n’est en cours de compilation. Vos apps et réglages sont conservés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートはAppのビルド中以外にインストールされます。Appと設定はそのまま保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新会在没有构建 App 时安装。你的 App 和设置会保留。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As atualizações são instaladas quando nenhum app está sendo compilado. Seus apps e ajustes são mantidos."
          }
        }
      }

{
  "sourceLanguage": "en",
  "strings": {
    "%@ could not be added to the provisioning profile. Open the project in Xcode and run it on %@ once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ konnte nicht zum Provisioning-Profil hinzugefügt werden. Öffne das Projekt in Xcode und führe es einmal auf %2$@ aus."
          }
        }
      }
    },
    "%@ could not be renewed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ konnte nicht erneuert werden"
          }
        }
      }
    },
    "%@ expires soon": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ läuft bald ab"
          }
        }
      }
    },
    "%@ expires soon on %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ läuft auf %2$@ bald ab"
          }
        }
      }
    },
    "%@ is not reachable. KeepAlive will try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht erreichbar. KeepAlive versucht es später erneut."
          }
        }
      }
    },
    "%@ took too long and was stopped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat zu lange gedauert und wurde abgebrochen."
          }
        }
      }
    },
    "%@ · Not reachable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Nicht erreichbar"
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        }
      }
    },
    "%@: expires %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft auf %1$@ %2$@ ab"
          }
        }
      }
    },
    "%lld devices": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Geräte"
          }
        }
      }
    },
    "%lld devices not reachable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Geräte nicht erreichbar"
          }
        }
      }
    },
    "A free Apple Account can create ten new app IDs per week. Try again in a few days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem kostenlosen Apple Account lassen sich zehn neue App-IDs pro Woche erstellen. Versuche es in ein paar Tagen erneut."
          }
        }
      }
    },
    "A free Apple Account can have three of your own apps on a device at the same time. Remove one of them from the device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem kostenlosen Apple Account können drei eigene Apps gleichzeitig auf einem Gerät sein. Entferne eine davon vom Gerät."
          }
        }
      }
    },
    "A free Apple Account can have up to three of your own apps installed on a device at the same time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem kostenlosen Apple Account können bis zu drei eigene Apps gleichzeitig auf einem Gerät installiert sein."
          }
        }
      }
    },
    "Activity": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivität"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen"
          }
        }
      }
    },
    "Add an Xcode project, and KeepAlive keeps its app installed on your iPhone or iPad.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Xcode-Projekt hinzu, damit seine App auf deinem iPhone oder iPad installiert bleibt."
          }
        }
      }
    },
    "Add App…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App hinzufügen …"
          }
        }
      }
    },
    "Add your Apple Account in Xcode’s settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deinen Apple Account in den Einstellungen von Xcode hinzu."
          }
        }
      }
    },
    "Added.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzugefügt."
          }
        }
      }
    },
    "Adding %@ to the provisioning profile…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird zum Provisioning-Profil hinzugefügt …"
          }
        }
      }
    },
    "Apps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps"
          }
        }
      }
    },
    "Apps signed with a free Apple Account stop opening after seven days. KeepAlive renews them early, whenever your iPhone or iPad is on the same network. Apps that expire within a day are renewed on battery power too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die mit einem kostenlosen Apple Account signiert sind, lassen sich nach sieben Tagen nicht mehr öffnen. KeepAlive erneuert sie frühzeitig, sobald dein iPhone oder iPad im selben Netzwerk ist. Apps, die innerhalb eines Tages ablaufen, werden auch im Batteriebetrieb erneuert."
          }
        }
      }
    },
    "Before Build": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Build"
          }
        }
      }
    },
    "Build failed: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Build fehlgeschlagen: %@"
          }
        }
      }
    },
    "Building for %@…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Build für %@ …"
          }
        }
      }
    },
